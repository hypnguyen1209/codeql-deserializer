# Editor / OS
.vs/
.idea/
*.iml
.DS_Store
Thumbs.db

# Python bytecode caches
__pycache__/
*.pyc

# Codex/Claude session transcripts occasionally dropped in the tree
rollout-*.jsonl

# Test / build outputs
test-results/
*.sarif
# examples build outputs
examples/java/classes/
examples/java/sources.txt
examples/java/*.sarif
# tests build artifacts (debug build.cmd)
tests/_classes/
tests/_srcs.txt
tests/java/build.cmd

# cfr decompiler cache
tools/.cache/


# generated scoped hunt query
java/_generated/


# codeql test runner leftovers
*.testproj/
